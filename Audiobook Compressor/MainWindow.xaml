<!--
    Filename: MainWindow.xaml
    Last Updated: 2025-08-09 12:30 CEST
    Version: 1.2.G
    State: Experimental
    Signed: Vanguard

    Synopsis:
    MVVM data binding implementation - Phase 3 basic controls conversion per Focus 14.1.0.
    Converting from event-driven code-behind to pure XAML data binding with MainViewModel.
-->
<Window x:Class="Audiobook_Compressor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Audiobook_Compressor"
        xmlns:converters="clr-namespace:Audiobook_Compressor.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="EXML Rockit" Width="600" MinHeight="250" MaxHeight="800" MinWidth="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Updated Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:ProgressWidthConverter x:Key="ProgressWidthConverter"/>
        <converters:BitrateValidationConverter x:Key="BitrateValidationConverter"/>
        <converters:RadioButtonToStringConverter x:Key="RadioButtonToStringConverter"/>
        
        <!-- Existing Style Resources -->
        <SolidColorBrush x:Key="SubtleTextColor" Color="Gray"/>
        <SolidColorBrush x:Key="ProgressBarFillColor" Color="#FFE0E0E0"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,5"/>
        </Style>
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Padding" Value="30,10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="20,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FF707070"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                        BorderBrush="#FF707070"
                                        Background="#DDDDDD"
                                        BorderThickness="1"
                                        Focusable="false"
                                        IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2"
                                                    Background="#DDDDDD"
                                                    BorderBrush="#FF707070"
                                                    BorderThickness="1"/>
                                            <!-- Down arrow -->
                                            <Path Grid.Column="1"
                                                  Fill="Black"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <!-- Content area -->
                            <ContentPresenter Name="ContentSite"
                                            Margin="8,0,25,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Content="{TemplateBinding SelectionBoxItem}"
                                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}">
                                <ContentPresenter.Style>
                                    <Style TargetType="ContentPresenter">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentPresenter.Style>
                            </ContentPresenter>
                            <TextBox x:Name="PART_EditableTextBox"
                                    Margin="5,0,25,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Focusable="True"
                                    IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}"
                                    BorderThickness="0"
                                    BorderBrush="Transparent">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditable, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <!-- Popup for dropdown -->
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="White"
                                            BorderThickness="1"
                                            BorderBrush="#DDDDDD"/>
                                    <ScrollViewer Margin="4,6,4,6"
                                                SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Grid Margin="15" DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Phase 3: Basic Controls with Data Binding -->
            <StackPanel Grid.Row="0">
                <Label Content="Source Library:" FontWeight="SemiBold"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             Text="{Binding Settings.SourcePath, Mode=TwoWay}"
                             Margin="0,0,5,0" Padding="5" 
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" 
                            Command="{Binding BrowseSourceCommand}"
                            Content="Browse..."/>
                </Grid>

                <Label Content="Output Folder:" Margin="0,10,0,0" FontWeight="SemiBold"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             Text="{Binding Settings.OutputPath, Mode=TwoWay}"
                             Margin="0,0,5,0" Padding="5" 
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" 
                            Command="{Binding BrowseOutputCommand}"
                            Content="Browse..."/>
                </Grid>
            </StackPanel>

            <Expander x:Name="SettingsExpander" Grid.Row="1" Margin="0,20,0,5" IsExpanded="False">
                <Expander.Header>
                    <TextBlock Text="{Binding SettingsSummary}" 
                             Foreground="{StaticResource SubtleTextColor}"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="500"/>
                </Expander.Header>
                <Border BorderBrush="#FFD3D3D3" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,5,0,0">
                    <StackPanel>
                        <TextBlock Text="Compression Settings:" FontWeight="SemiBold" Margin="0,5,0,5"/>
                        <!-- Phase 4: Main Settings ComboBoxes (to be converted) -->
                        <WrapPanel>
                            <ComboBox SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                                      ItemsSource="{Binding ChannelOptions}"
                                      MinWidth="80" Margin="3" 
                                      Style="{StaticResource SettingsComboBoxStyle}"/>
                            <ComboBox Text="{Binding SelectedBitrate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                      ItemsSource="{Binding BitrateOptions}"
                                      MinWidth="80" Margin="3" 
                                      Style="{StaticResource SettingsComboBoxStyle}" 
                                      IsEditable="True"/>
                            <ComboBox SelectedItem="{Binding SelectedSampleRate, Mode=TwoWay}"
                                      ItemsSource="{Binding SampleRateOptions}"
                                      MinWidth="90" Margin="3" 
                                      Style="{StaticResource SettingsComboBoxStyle}"/>
                            <ComboBox Text="{Binding SelectedThreshold, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                      ItemsSource="{Binding BitrateOptions}"
                                      MinWidth="80" Margin="3" 
                                      ToolTip="Copy mono files instead of re-encoding if their bitrate is below this value." 
                                      Style="{StaticResource SettingsComboBoxStyle}" 
                                      IsEditable="True"/>
                            <ComboBox SelectedItem="{Binding SelectedEncodingType, Mode=TwoWay}"
                                      ItemsSource="{Binding EncodingTypeOptions}"
                                      MinWidth="80" Margin="3" 
                                      Style="{StaticResource SettingsComboBoxStyle}"/>
                            <ComboBox SelectedItem="{Binding SelectedPassMode, Mode=TwoWay}"
                                      ItemsSource="{Binding PassModeOptions}"
                                      MinWidth="80" Margin="3" 
                                      IsEnabled="{Binding IsPassModeEnabled}"
                                      Style="{StaticResource SettingsComboBoxStyle}"/>
                        </WrapPanel>
                        <!-- Phase 4: Radio Button Groups (to be converted) -->
                        <StackPanel Visibility="{Binding IsMonoModeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <WrapPanel Margin="0,10,0,0">
                                <RadioButton IsChecked="{Binding IsMonoCopySelected, Mode=TwoWay}"
                                           Content="Copy stereo files" 
                                           GroupName="MonoModeGroup" Margin="0,0,10,0"/>
                                <RadioButton IsChecked="{Binding IsMonoConvertSelected, Mode=TwoWay}"
                                           Content="Convert stereo to mono" 
                                           GroupName="MonoModeGroup" Margin="0,0,10,0"/>
                                <RadioButton IsChecked="{Binding IsMonoAdvancedSelected, Mode=TwoWay}"
                                           Content="Advanced..." 
                                           GroupName="MonoModeGroup"/>
                            </WrapPanel>
                            <!-- Advanced Panel with Conditional Visibility -->
                            <WrapPanel Visibility="{Binding IsMonoAdvancedPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
                                       Margin="0,10,0,0">
                                <!-- Phase 4: Advanced ComboBoxes (to be converted) -->
                                <ComboBox SelectedItem="{Binding MonoAdvancedSettings.ChannelMode, Mode=TwoWay}"
                                          ItemsSource="{Binding ChannelOptions}"
                                          MinWidth="80" Margin="3" Style="{StaticResource SettingsComboBoxStyle}"/>
                                <ComboBox Text="{Binding MonoAdvancedSettings.TargetBitrate, Mode=TwoWay}"
                                          ItemsSource="{Binding BitrateOptions}"
                                          MinWidth="80" Margin="3" Style="{StaticResource SettingsComboBoxStyle}" IsEditable="True"/>
                                <ComboBox SelectedItem="{Binding MonoAdvancedSettings.SampleRate, Mode=TwoWay}"
                                          ItemsSource="{Binding SampleRateOptions}"
                                          MinWidth="90" Margin="3" Style="{StaticResource SettingsComboBoxStyle}"/>
                                <ComboBox Text="{Binding MonoAdvancedSettings.ConversionThreshold, Mode=TwoWay}"
                                          ItemsSource="{Binding BitrateOptions}"
                                          MinWidth="80" Margin="3" Style="{StaticResource SettingsComboBoxStyle}" IsEditable="True"/>
                                <ComboBox SelectedItem="{Binding MonoAdvancedSettings.EncodingType, Mode=TwoWay}"
                                          ItemsSource="{Binding EncodingTypeOptions}"
                                          MinWidth="80" Margin="3" Style="{StaticResource SettingsComboBoxStyle}"/>
                                <ComboBox SelectedItem="{Binding MonoAdvancedSettings.PassMode, Mode=TwoWay}"
                                          ItemsSource="{Binding PassModeOptions}"
                                          MinWidth="80" Margin="3" Style="{StaticResource SettingsComboBoxStyle}"/>
                                <!-- Sub-threshold behavior section -->
                                <StackPanel Margin="0,5,0,0" HorizontalAlignment="Stretch" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}">
                                    <TextBlock Text="For files below threshold:" FontWeight="SemiBold" Margin="0,4,5,5"/>
                                    <Grid Margin="0,-1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Content="Copy" Grid.Column="0"
                                                     IsChecked="{Binding Path=MonoAdvancedSettings.SubThresholdAction, 
                                                                 Converter={StaticResource RadioButtonToStringConverter}, 
                                                                 ConverterParameter=Copy, Mode=TwoWay}"
                                                     GroupName="MonoAdvancedSubThresholdGroup" 
                                                     Margin="0,0,15,0" VerticalAlignment="Center"/>
                                        <RadioButton Content="Defer to Rockit" Grid.Column="1"
                                                     IsChecked="{Binding Path=MonoAdvancedSettings.SubThresholdAction, 
                                                                 Converter={StaticResource RadioButtonToStringConverter}, 
                                                                 ConverterParameter=DeferToRockit, Mode=TwoWay}"
                                                     GroupName="MonoAdvancedSubThresholdGroup" 
                                                     Margin="0,0,15,0" VerticalAlignment="Center"/>
                                        <RadioButton Content="Convert to:" Grid.Column="2"
                                                     IsChecked="{Binding Path=MonoAdvancedSettings.SubThresholdAction, 
                                                                 Converter={StaticResource RadioButtonToStringConverter}, 
                                                                 ConverterParameter=ConvertTo, Mode=TwoWay}"
                                                     GroupName="MonoAdvancedSubThresholdGroup" 
                                                     Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <ComboBox Text="{Binding MonoAdvancedSettings.CustomTargetBitrate, Mode=TwoWay}"
                                                  IsEnabled="{Binding Path=MonoAdvancedSettings.SubThresholdAction, 
                                                              Converter={StaticResource RadioButtonToStringConverter}, 
                                                              ConverterParameter=ConvertTo}"
                                                  Grid.Column="3" MinWidth="80" Height="28"
                                                  VerticalAlignment="Center" Margin="2,-1,0,0"
                                                  IsEditable="True"
                                                  Style="{StaticResource SettingsComboBoxStyle}">
                                            <ComboBoxItem Content="48k"/>
                                            <ComboBoxItem Content="64k"/>
                                            <ComboBoxItem Content="96k"/>
                                            <ComboBoxItem Content="128k"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsStereoModeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <WrapPanel Margin="0,10,0,0">
                                <RadioButton IsChecked="{Binding IsStereoCopySelected, Mode=TwoWay}"
                                           Content="Copy mono files" 
                                           GroupName="StereoModeGroup" Margin="0,0,10,0"/>
                                <RadioButton IsChecked="{Binding IsStereoConvertSelected, Mode=TwoWay}"
                                           Content="Convert mono to stereo" 
                                           GroupName="StereoModeGroup" Margin="0,0,10,0"/>
                                <RadioButton IsChecked="{Binding IsStereoAdvancedSelected, Mode=TwoWay}"
                                           Content="Advanced..." 
                                           GroupName="StereoModeGroup"/>
                            </WrapPanel>
                            <WrapPanel Visibility="{Binding IsStereoAdvancedPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
                                       Margin="0,10,0,0">
                                <!-- Phase 4: Stereo Advanced ComboBoxes -->
                                <ComboBox SelectedItem="{Binding StereoAdvancedSettings.ChannelMode, Mode=TwoWay}"
                                          ItemsSource="{Binding ChannelOptions}"
                                          MinWidth="80" Margin="3" Style="{StaticResource SettingsComboBoxStyle}"/>
                                <ComboBox Text="{Binding StereoAdvancedSettings.TargetBitrate, Mode=TwoWay}"
                                          ItemsSource="{Binding BitrateOptions}"
                                          MinWidth="80" Margin="3" Style="{StaticResource SettingsComboBoxStyle}" IsEditable="True"/>
                                <ComboBox SelectedItem="{Binding StereoAdvancedSettings.SampleRate, Mode=TwoWay}"
                                          ItemsSource="{Binding SampleRateOptions}"
                                          MinWidth="90" Margin="3" Style="{StaticResource SettingsComboBoxStyle}"/>
                                <ComboBox Text="{Binding StereoAdvancedSettings.ConversionThreshold, Mode=TwoWay}"
                                          ItemsSource="{Binding BitrateOptions}"
                                          MinWidth="80" Margin="3" Style="{StaticResource SettingsComboBoxStyle}" IsEditable="True"/>
                                <ComboBox SelectedItem="{Binding StereoAdvancedSettings.EncodingType, Mode=TwoWay}"
                                          ItemsSource="{Binding EncodingTypeOptions}"
                                          MinWidth="80" Margin="3" Style="{StaticResource SettingsComboBoxStyle}"/>
                                <ComboBox SelectedItem="{Binding StereoAdvancedSettings.PassMode, Mode=TwoWay}"
                                          ItemsSource="{Binding PassModeOptions}"
                                          MinWidth="80" Margin="3" Style="{StaticResource SettingsComboBoxStyle}"/>
                                <!-- Sub-threshold behavior section -->
                                <StackPanel Margin="0,5,0,0" HorizontalAlignment="Stretch" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}">
                                    <TextBlock Text="For files below threshold:" FontWeight="SemiBold" Margin="0,4,5,5"/>
                                    <Grid Margin="0,-1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Content="Copy" Grid.Column="0"
                                                     IsChecked="{Binding Path=StereoAdvancedSettings.SubThresholdAction, 
                                                                 Converter={StaticResource RadioButtonToStringConverter}, 
                                                                 ConverterParameter=Copy, Mode=TwoWay}"
                                                     GroupName="StereoAdvancedSubThresholdGroup" 
                                                     Margin="0,0,15,0" VerticalAlignment="Center"/>
                                        <RadioButton Content="Defer to Rockit" Grid.Column="1"
                                                     IsChecked="{Binding Path=StereoAdvancedSettings.SubThresholdAction, 
                                                                 Converter={StaticResource RadioButtonToStringConverter}, 
                                                                 ConverterParameter=DeferToRockit, Mode=TwoWay}"
                                                     GroupName="StereoAdvancedSubThresholdGroup" 
                                                     Margin="0,0,15,0" VerticalAlignment="Center"/>
                                        <RadioButton Content="Convert to:" Grid.Column="2"
                                                     IsChecked="{Binding Path=StereoAdvancedSettings.SubThresholdAction, 
                                                                 Converter={StaticResource RadioButtonToStringConverter}, 
                                                                 ConverterParameter=ConvertTo, Mode=TwoWay}"
                                                     GroupName="StereoAdvancedSubThresholdGroup" 
                                                     Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <ComboBox Text="{Binding StereoAdvancedSettings.CustomTargetBitrate, Mode=TwoWay}"
                                                  IsEnabled="{Binding Path=StereoAdvancedSettings.SubThresholdAction, 
                                                              Converter={StaticResource RadioButtonToStringConverter}, 
                                                              ConverterParameter=ConvertTo}"
                                                  Grid.Column="3" MinWidth="80" Height="28"
                                                  VerticalAlignment="Center" Margin="2,-1,0,0"
                                                  IsEditable="True"
                                                  Style="{StaticResource SettingsComboBoxStyle}">
                                            <ComboBoxItem Content="48k"/>
                                            <ComboBoxItem Content="64k"/>
                                            <ComboBoxItem Content="96k"/>
                                            <ComboBoxItem Content="128k"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                        <!-- File Types -->
                        <TextBlock Text="File Types:" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <WrapPanel>
                            <CheckBox Content=".m4b" Margin="3" IsChecked="True"/>
                            <CheckBox Content=".mp3" Margin="3" IsChecked="True"/>
                            <CheckBox Content=".aac" Margin="3" IsChecked="True"/>
                            <CheckBox Content=".m4a" Margin="3" IsChecked="True"/>
                            <CheckBox Content=".flac" Margin="3" IsChecked="True"/>
                            <CheckBox Content=".ogg" Margin="3" IsChecked="True"/>
                            <CheckBox Content=".wma" Margin="3" IsChecked="True"/>
                            <CheckBox Content=".wav" Margin="3" IsChecked="True"/>
                            <CheckBox Content=".webma" Margin="3" IsChecked="True"/>
                            <CheckBox Content=".opus" Margin="3" IsChecked="True"/>
                        </WrapPanel>
                        <TextBlock Text="Output Folder Defaults:" FontWeight="SemiBold" Margin="0,10,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SaveDefaultCommand}" Content="Set" Margin="3"/>
                            <Button Command="{Binding RestoreDefaultCommand}" Content="Restore" Margin="3"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Expander>

            <Expander x:Name="LogExpander" Grid.Row="2" Margin="0,5,0,5" IsExpanded="False">
                <Expander.Header>
                    <TextBlock Text="{Binding StatusText}" 
                               Foreground="{StaticResource SubtleTextColor}" 
                               TextTrimming="CharacterEllipsis"/>
                </Expander.Header>
                <TextBox Text="{Binding LogContent, Mode=OneWay}"
                         MinHeight="100" MaxHeight="400" Margin="0,5,0,0" 
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" 
                         HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" 
                         FontFamily="Consolas"/>
            </Expander>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Command="{Binding StartProcessingCommand}" 
                        IsEnabled="{Binding CanStartProcessing}"
                        Content="Start" 
                        Style="{StaticResource ActionButtonStyle}" />
                <Button Command="{Binding CancelProcessingCommand}" 
                        IsEnabled="{Binding CanCancelProcessing}"
                        Content="Cancel" 
                        Style="{StaticResource ActionButtonStyle}"/>
            </StackPanel>

            <StatusBar Grid.Row="4" Margin="0,10,0,0" Height="22">
                <StatusBar.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </StatusBar.ItemsPanel>
                <StatusBarItem HorizontalAlignment="Stretch" 
                               HorizontalContentAlignment="Stretch" 
                               VerticalContentAlignment="Stretch"
                               Padding="0">
                    <Grid x:Name="StatusBarGrid" 
                          HorizontalAlignment="Stretch" 
                          VerticalAlignment="Stretch"
                          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=StatusBarItem}}"
                          Margin="0">
                        <!-- Progress fill background -->
                        <Rectangle Fill="#FFB0B0B0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Stretch"
                                  RadiusX="0" RadiusY="0"
                                  IsHitTestVisible="False"
                                  Margin="0"
                                  Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource ProgressWidthConverter}">
                                    <Binding ElementName="StatusBarGrid" Path="ActualWidth"/>
                                    <Binding Path="StatusProgress"/>
                                </MultiBinding>
                            </Rectangle.Width>
                        </Rectangle>
                        <!-- Status text -->
                        <TextBlock Text="{Binding StatusText}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="5,0,0,0"/>
                    </Grid>
                </StatusBarItem>
            </StatusBar>
        </Grid>
    </DockPanel>
</Window>